{
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "Images/*": [
        "./src/assets/images/*"
      ],
      "Components/*": [
        "./src/components/*"
      ],
      "Utils/*": [
        "./src/utils/*"
      ],
      "Assets/*": [
        "./src/assets/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
